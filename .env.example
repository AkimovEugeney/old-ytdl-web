# --- Бэкенд ytdl-service-back (только сервер, в браузер не попадает) ---
BACKEND_URL=https://your-backend.example.com
BACKEND_TOKEN=            # тот же API_TOKEN, что в бэкенде (Bearer)
# Публичный адрес бэкенда, с которого БРАУЗЕР скачивает готовый файл.
# Если пусто — используется BACKEND_URL.
BACKEND_PUBLIC_URL=

# Общий секрет подписи ссылок на скачивание. Должен совпадать с WEB_DOWNLOAD_SECRET в бэкенде.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOWNLOAD_SIGNING_SECRET=

# --- Сайт / SEO ---
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=Purple Download
# Необязательно: e-mail для обращений правообладателей (показывается на /copyright)
NEXT_PUBLIC_CONTACT_EMAIL=
# Коды подтверждения владения сайтом
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# --- Аналитика ---
# ID счётчика Яндекс Метрики (пусто = не подключать)
NEXT_PUBLIC_YM_ID=

# --- Реклама (подключим вместе) ---
# true — показывать рекламные слоты (components/AdSlot.tsx)
NEXT_PUBLIC_ADS_ENABLED=false
# ID страницы РСЯ (автоблоки); по умолчанию 20238177
NEXT_PUBLIC_YANDEX_ADS_PAGE_ID=

# --- Лимиты запросов (Upstash Redis, REST). Без них лимит считается в памяти инстанса ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Скачиваний в сутки с одного IP (на сайте показывается пользователю как «5 в день»; при смене обновить тексты)
PREPARE_DAILY_LIMIT=5

# Временный провайдер SaveNow (необязательно). Только сервер.
SAVENOW_API_KEY=
